<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildToolsPath)\Microsoft.Common.props" Condition="Exists('$(MSBuildToolsPath)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{5C6E9C1D-2B5E-4B0A-9B8B-7B1E9C1D2B5E}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>ClashIdFixer</RootNamespace>
    <AssemblyName>ClashIdFixer</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <LangVersion>7.3</LangVersion>
    <!-- Navisworks 2022 is 64-bit only; match it to avoid MSIL/AMD64 mismatch warnings. -->
    <PlatformTarget>x64</PlatformTarget>

    <!--
      Point this at your local Navisworks 2022 install (folder containing
      Autodesk.Navisworks.Api.dll). Override without editing this file by
      passing /p:NavisworksInstallDir=... to msbuild, or by setting the
      NAVISWORKS_2022_DIR environment variable before opening the solution.
    -->
    <NavisworksInstallDir Condition=" '$(NavisworksInstallDir)' == '' and '$(NAVISWORKS_2022_DIR)' != '' ">$(NAVISWORKS_2022_DIR)</NavisworksInstallDir>
    <NavisworksInstallDir Condition=" '$(NavisworksInstallDir)' == '' ">C:\Program Files\Autodesk\Navisworks Manage 2022\</NavisworksInstallDir>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Xml" />

    <!--
      Managed API shipped with Navisworks Manage/Simulate 2022. The core
      assembly gives the model tree and properties; Autodesk.Navisworks.Clash
      gives the live Clash Detective results (DocumentClash.TestsData) used by
      the api-mode button. No COM interop, no NuGet.
    -->
    <Reference Include="Autodesk.Navisworks.Api">
      <HintPath>$(NavisworksInstallDir)Autodesk.Navisworks.Api.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Autodesk.Navisworks.Clash">
      <HintPath>$(NavisworksInstallDir)Autodesk.Navisworks.Clash.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Config\ClashIdFixerConfig.cs" />
    <Compile Include="Core\KnownFolders.cs" />
    <Compile Include="Core\ReportPostProcessor.cs" />
    <Compile Include="Core\ClashApiPostProcessor.cs" />
    <Compile Include="UI\ProgressForm.cs" />
    <Compile Include="Plugin\FixReportRunner.cs" />
    <Compile Include="Plugin\FixReportCommand.cs" />
    <Compile Include="Plugin\FixReportApiCommand.cs" />
    <Compile Include="Plugin\BimUpRibbonPlugin.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Ribbon layout ("BIM УП" tab) and its display-name strings. Navisworks
      loads these as LOOSE FILES from a locale subfolder next to the DLL
      (NOT embedded), so they are copied to bin\...\en-US and bin\...\ru-RU.
      The ru-RU copy makes a Russian-language Navisworks find them in its own
      locale folder; en-US is the fallback.
    -->
    <None Include="en-US\ClashIdFixer.xaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="en-US\ClashIdFixer.name">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="ru-RU\ClashIdFixer.xaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="ru-RU\ClashIdFixer.name">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>

    <!--
      Button icons - also loose files, referenced by the Command attribute as
      a path relative to the plugin folder (Resources\FixId16.png).
    -->
    <Content Include="Resources\FixId16.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\FixId32.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Navisworks discovers add-ins by scanning its Plugins folder for DLLs carrying
    the [Plugin] attribute, so the built assembly just needs to be copied there -
    see README.md for the exact path and packaging steps.
  -->

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
