<?xml version="1.0" encoding="utf-8"?>
<!--
  Пример файла настроек. При первом запуске плагина файл
  "ClashIdFixer.config.xml" с такими же значениями по умолчанию создаётся
  автоматически рядом с ClashIdFixer.dll. Отредактируйте его под свой проект.
-->
<ClashIdFixerConfig>
  <!-- Куда сохранять исправленный XML. Пусто = папка "Загрузки" пользователя. -->
  <OutputFolder></OutputFolder>

  <!--
    Имена атрибутов (objectattribute/smarttag) в стандартном отчёте, значение
    которых является Id элемента и подлежит проверке/замене. В стандартном
    русском отчёте это "ID объекта".
  -->
  <ReportIdAttributeNames>
    <Name>ID объекта</Name>
    <Name>ИД объекта</Name>
    <Name>Object ID</Name>
    <Name>Object Id</Name>
  </ReportIdAttributeNames>

  <!--
    Где лежит истинный Id: вкладка свойств "Объект", графа "Id" (есть только
    у элемента "правильного выбора"). Проверяются все сочетания
    категория x свойство, и по отображаемым, и по внутренним именам.
  -->
  <TrueIdCategories>
    <Name>Объект</Name>
    <Name>Item</Name>
    <Name>Элемент</Name>
    <Name>Element</Name>
  </TrueIdCategories>
  <TrueIdProperties>
    <Name>Id</Name>
    <Name>ID</Name>
    <Name>ИД</Name>
    <Name>Ид</Name>
    <Name>Идентификатор</Name>
  </TrueIdProperties>
</ClashIdFixerConfig>
