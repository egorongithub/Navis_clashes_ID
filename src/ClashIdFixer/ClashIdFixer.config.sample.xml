<?xml version="1.0" encoding="utf-8"?>
<!--
  Пример файла настроек. При первом запуске плагина файл
  "ClashIdFixer.config.xml" с такими же значениями по умолчанию создаётся
  автоматически рядом с ClashIdFixer.dll. Отредактируйте его под свой проект.
-->
<ClashIdFixerConfig>
  <!-- Куда сохранять исправленный XML. Пусто = папка "Загрузки" пользователя. -->
  <OutputFolder></OutputFolder>

  <!--
    Запасной список типов узлов, считающихся "объектом" (правильным выбором).
    Основная проверка - флаг API ModelItem.IsComposite, этот список нужен
    только для файлов, где флаг не выставлен.
  -->
  <ObjectNodeTypes>
    <NodeType>Composite Object</NodeType>
    <NodeType>Insert Group</NodeType>
    <NodeType>Составной объект</NodeType>
    <NodeType>Группа вставки</NodeType>
  </ObjectNodeTypes>
</ClashIdFixerConfig>
